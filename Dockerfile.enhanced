# ── 增强镜像：Docling 可选生产解析（默认镜像的增强变体） ──
# 在默认 Dockerfile（不装 docling）基础上预装 docling 并启用开关。
# 使用方式：
#   docker build -f Dockerfile.enhanced -t no0_ai_backend:enhanced .
#   # docker-compose.yml 中把 backend.build 指向 ./Dockerfile.enhanced
#   # 或 image: no0_ai_backend:enhanced
# 说明：
#   - ENV AIILIE_DOCLING_ENABLED=true 由 config_manager 自动映射为 docling.enabled=true；
#   - 离线部署请预下载模型工件并挂载到 docling.model_cache_dir
#     （默认 %APPDATA%/No0_AI_V4/data/docling_models，容器内可经环境变量
#     AIILIE_DOCLING_MODEL_CACHE_DIR 覆盖）。
FROM python:3.10-slim

WORKDIR /app

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 复制依赖定义并安装（与默认镜像一致）
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── 增强：安装 docling（可选结构化解析：表格/页码/版面） ──
RUN pip install --no-cache-dir docling

# 复制所有源代码
COPY . .

# 启用 docling 可选解析（config_manager 自动映射 AIILIE_DOCLING_ENABLED → docling.enabled）
ENV AIILIE_DOCLING_ENABLED=true

# 暴露 FastAPI 默认端口
EXPOSE 8000

# 运行服务
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
